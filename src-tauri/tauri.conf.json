{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HEIC Converter",
  "version": "1.0.0",
  "identifier": "com.eugenachtzehn.heicconverter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HEIC Converter",
        "width": 780,
        "height": 760,
        "minWidth": 620,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Photography",
    "shortDescription": "Offline HEIC to JPEG batch converter",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
